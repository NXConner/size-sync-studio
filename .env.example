# Server (Express)
NODE_ENV=development
PORT=3001
API_PREFIX=/api
WEB_ORIGIN=http://localhost:8080
# Optional observability
SENTRY_DSN=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Optional Reddit OAuth
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=

# Frontend (Vite)
VITE_APP_BASENAME=
VITE_API_BASE=/api
VITE_SENTRY_DSN=
# Supabase
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Feature flags
VITE_FLAG_ADVANCED_ML=0
VITE_FLAG_EXPERIMENT_MEASURE=0
